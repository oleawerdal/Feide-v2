# Kopier til .env og tilpass. ALDRI sjekk inn ekte hemmeligheter.

NODE_ENV=development
PORT=8443

# Web-TLS (HTTPS). La stå tomt for HTTP i utvikling.
# TLS_CERT_FILE=./certs/web.crt
# TLS_KEY_FILE=./certs/web.key

# --- LDAP ---
# Bruk alltid ldaps:// (kryptert). Test-containeren lytter på 1636.
LDAP_URL=ldaps://127.0.0.1:1636
LDAP_BIND_DN=cn=admin,dc=skole,dc=kommune,dc=no
LDAP_BIND_PASSWORD=adminpass
LDAP_BASE_DN=dc=skole,dc=kommune,dc=no
LDAP_PEOPLE_OU=ou=people
LDAP_GROUPS_OU=ou=groups

# Verifiser tjenersertifikatet mot denne CA-en (selvsignert i test).
LDAP_CA_FILE=./certs/ca.crt
LDAP_TLS_REJECT_UNAUTHORIZED=true

# Kun medlemmer av denne gruppen får logge inn i portalen.
LDAP_ADMIN_GROUP_DN=cn=feide-admins,ou=groups,dc=skole,dc=kommune,dc=no

# Standard realm for nye personer/grupper.
REALM=skole.kommune.no

# --- Sesjon ---
# Sett en sterk, tilfeldig verdi i produksjon (f.eks. `openssl rand -hex 32`).
SESSION_SECRET=dev-secret-skift-meg-skift-meg-1234
SESSION_TTL_MINUTES=60
